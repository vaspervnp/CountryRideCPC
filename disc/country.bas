10 REM COUNTRY RIDE - loader (README.md: The loader)
70 MODE 0:BORDER 1:FOR i=0 TO 15:INK i,0:NEXT
80 MEMORY &18FF
90 LOAD"SELECT.BIN",&4000:CALL &4000
100 FOR i=0 TO 15:READ c:INK i,c:NEXT:INK 13,24,15
110 FOR i=0 TO 4:OUT &7F00,&C4+i+8*(i=4):LOAD"SPIN"+CHR$(65+i)+".BIN",&8000:CALL &A600:NEXT
120 LOAD"SPIN.BIN",&8000:CALL &A600:CALL &9C00
150 INK 14,1:INK 15,26:s=0:p=13:GOSUB 510:v=1:GOSUB 710
170 k$=UPPER$(INKEY$):IF k$>="1" AND k$<="4" THEN p=2:GOSUB 510:s=VAL(k$)-1:p=13:GOSUB 510:GOTO 300
175 IF k$<>"" THEN i=INSTR("EMH",k$):IF i THEN v=i-1:GOSUB 760
180 j=JOY(0):d=0
190 IF INKEY(8)=0 OR INKEY(34)=0 OR (j AND 4) THEN d=3
200 IF INKEY(1)=0 OR INKEY(27)=0 OR (j AND 8) THEN d=1
210 IF INKEY(0)=0 OR INKEY(2)=0 OR (j AND 3) THEN d=2
220 IF d THEN p=2:GOSUB 510:s=(s+d) MOD 4:p=13:GOSUB 510:GOSUB 600
230 IF INKEY(47)=0 OR INKEY(18)=0 OR INKEY(6)=0 OR (j AND 48) THEN 300
240 GOTO 170
300 CALL &9C03:INK 15,1
310 OUT &7F00,&C4:LOAD"ROADA.BIN",&8000:CALL &A600
320 OUT &7F00,&C5:LOAD"ROADB.BIN",&8000:CALL &A600
330 OUT &7F00,&C6:LOAD"ROADC.BIN",&8000:CALL &A600
340 OUT &7F00,&C7:LOAD"GAME.BIN",&8000:CALL &A600
345 LOAD"SOUND.BIN",&8000:CALL &A600:LOAD"RACE.BIN",&8000:CALL &A600
350 OUT &7F00,&C0:FOR i=0 TO 15:INK i,0:NEXT:BORDER 0
360 LOAD"CAR"+CHR$(48+s)+".BIN",&C000:CALL &A605:POKE &1906,32*v
370 LOAD"BOOT.BIN",&C000:CALL &A605:CALL &4000
510 x=4+320*(s MOD 2):y=360-158*(s\2)
520 MOVE x,y:DRAWR 308,0,p:DRAWR 0,-150:DRAWR -308,0:DRAWR 0,150
530 MOVE x,y-2:DRAWR 308,0:MOVE x,y-148:DRAWR 308,0:RETURN
600 IF INKEY(8)=0 OR INKEY(34)=0 OR INKEY(1)=0 OR INKEY(27)=0 OR INKEY(0)=0 OR INKEY(2)=0 OR JOY(0) THEN 600
610 RETURN
710 FOR i=0 TO 9:a=&C7D0+&7D6*(i\6)+7*i:SYMBOL 240+i,PEEK(a),PEEK(a+1),PEEK(a+2),PEEK(a+3),PEEK(a+4),PEEK(a+5),PEEK(a+6):NEXT
760 GRAPHICS PAPER 1:a=&D7D0:FOR i=0 TO 5:q=15:IF i AND 1 THEN q=3-10*(i\2=v)
770 FOR j=1 TO PEEK(a):MOVE 4*PEEK(a+2*j),47,q:TAG:PRINT CHR$(239+PEEK(a+2*j-1));:TAGOFF:NEXT:a=a+1+2*PEEK(a):NEXT:RETURN
1020 DATA 0,1,2,11,14,26,13,6,3,15,24,16,23,24,26,1
